<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This game runs Unity 2017 on the CLR 2.0 / .NET 3.5 profile. -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>QuickKeyRestart</AssemblyName>
    <RootNamespace>QuickKeyRestart</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">E:\Steam\steamapps\common\Overcooked! 2</GameDir>
    <ManagedDir>$(GameDir)\Overcooked2_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <!-- The game is reached by reflection only, so Assembly-CSharp is deliberately not referenced. -->
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputModule"><HintPath>$(ManagedDir)\UnityEngine.InputModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')" Text="Overcooked! 2 not found. Pass -p:GameDir=&quot;&lt;game folder&gt;&quot; to point at your install." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')" Text="Install BepInEx 5 x86 into the game folder first (installer\Install.cmd does it)." />
  </Target>
  <Target Name="StagePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\dist\" />
  </Target>
  <Target Name="InstallPlugin" AfterTargets="StagePlugin" Condition="'$(Configuration)' == 'Release' and '$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\QuickKeyRestart\" />
  </Target>
</Project>
