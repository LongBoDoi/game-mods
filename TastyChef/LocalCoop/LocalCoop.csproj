<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LocalCoop</AssemblyName>
    <RootNamespace>LocalCoop</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Point this at your game install if you ever move it:  build.cmd -p:GameDir="D:\Games\Tasty Chef" -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">E:\Steam\steamapps\common\Tasty Chef</GameDir>
    <ManagedDir>$(GameDir)\TastyChef_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExDir)\core\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(ManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(ManagedDir)\UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Services.Core"><HintPath>$(ManagedDir)\Unity.Services.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Services.Authentication"><HintPath>$(ManagedDir)\Unity.Services.Authentication.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Services.Multiplayer"><HintPath>$(ManagedDir)\Unity.Services.Multiplayer.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Netcode.Runtime"><HintPath>$(ManagedDir)\Unity.Netcode.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    Drop the built plugin straight into the game so you can just relaunch.
    The game locks the DLL while it is running, so a failed copy is a warning, not an error.
  -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\LocalCoop\"
          ContinueOnError="WarnAndContinue" Retries="0">
      <Output TaskParameter="CopiedFiles" ItemName="Deployed" />
    </Copy>
    <Message Importance="high" Condition="'@(Deployed)' != ''" Text="Deployed $(TargetFileName) -> $(BepInExDir)\plugins\LocalCoop\" />
    <Warning Condition="'@(Deployed)' == ''" Text="Build OK but NOT deployed - close the game and run: dotnet build -c Release" />

    <!-- Stage the DLL in the game's dist\ folder, which scripts\Release.ps1 zips with the installer. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\dist\" />
  </Target>

</Project>
